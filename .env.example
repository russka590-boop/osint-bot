# Токен бота из @BotFather
BOT_TOKEN=123456789:AA...

# Кому разрешён доступ. Если пусто — бот открыт всем (не рекомендуется).
# ID можно узнать, написав боту /start: он покажет ID при отказе в доступе.
ALLOWED_USER_IDS=
ADMIN_IDS=

# Ограничения нагрузки
MAX_CONCURRENT_JOBS=4
USER_COOLDOWN_SEC=30

# Maigret (pip install maigret)
MAIGRET_CMD=maigret
MAIGRET_ARGS=-a
MAIGRET_TIMEOUT=900

# BlackBird: путь к репозиторию p1ngul1n0/blackbird
# Пример Windows: BLACKBIRD_CMD=python C:\tools\blackbird\blackbird.py
# Пример Linux:   BLACKBIRD_CMD=python3 /opt/blackbird/blackbird.py
BLACKBIRD_CMD=
BLACKBIRD_ARGS=
BLACKBIRD_TIMEOUT=180

# Куда писать отчёты и базу аудита
REPORT_DIR=reports
DB_PATH=data/bot.sqlite3
